# Copy this file to .env and fill in your sandbox credentials.
# .env is git-ignored; never commit real credentials.

# --- Open Payments (https://docs.openpayments.io/) ---
# Create an application in the Developer Portal to get these.
OPEN_PAYMENTS_CLIENT_ID=
OPEN_PAYMENTS_CLIENT_SECRET=

# Sandbox hosts. Switch to https://auth.openbankingplatform.com and
# https://api.openbankingplatform.com for production (requires a client certificate).
OPEN_PAYMENTS_AUTH_BASE_URL=https://auth.sandbox.openbankingplatform.com
OPEN_PAYMENTS_API_BASE_URL=https://api.sandbox.openbankingplatform.com

# Space-separated API scope + PSU context scope.
# API scopes: aspspinformation, accountinformation, paymentinitiation, bankgiroinformation
# PSU context scopes: private, corporate
OPEN_PAYMENTS_SCOPE=aspspinformation corporate

# Comma-separated ISO country codes used when listing banks.
OPEN_PAYMENTS_ISO_COUNTRY_CODES=SE

# --- Zwapgrid API.1 (https://docs.zwapgrid.com/) ---
# Create a Development API key in the Client Portal: https://clients.zwapgrid.com
ZWAPGRID_API_KEY=

ZWAPGRID_CONSENTS_BASE_URL=https://apione.zwapgrid.com/consents
ZWAPGRID_ACCOUNTING_BASE_URL=https://apione.zwapgrid.com/accounting

# --- Shared ---
REQUEST_TIMEOUT_SECONDS=30
